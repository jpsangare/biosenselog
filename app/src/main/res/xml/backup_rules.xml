<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   Measurements and the daily step count are health data and are kept out of cloud backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="step_counter.xml" />
</full-backup-content>
