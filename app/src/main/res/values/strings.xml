    <string name="disclaimer_title">Not a medical device</string>
    <string name="disclaimer_body">BioSense Log is a wellness and self-tracking app. It is not a medical device and does not diagnose, treat or prevent any disease.\n\nPhone sensors are less accurate than medical equipment, and the reference ranges shown are general indications only.\n\nDo not use these readings to make health decisions. If you feel unwell or are worried about your health, contact a doctor. In an emergency, call your local emergency number.</string>
    <string name="disclaimer_accept">I understand</string>
    <string name="disclaimer_footer">Not a medical device. For wellness and self-tracking only, not for diagnosis.</string>
    <string name="welcome_title">Before you start</string>
    <string name="privacy_title">Your data stays on your phone</string>
    <string name="privacy_body">All your measurements are stored only on this phone. BioSense Log collects nothing and sends nothing: the app has no internet access. Your data leaves the phone only if you choose to export or share it yourself.</string>
    <string name="free_title">Free to use</string>
    <string name="free_body">BioSense Log is completely free. If you find it useful, please support it by rating it and leaving a review on Google Play, so more people can discover it.</string>
